{
    "name": "Straight Staircase",
    "nickname": "Stair",
    "category": "COMPAS Studio",
    "subcategory": "Circulation",
    "description": "Build a solid straight staircase from a step count. Pure COMPAS core, tested outside Rhino.",
    "exposure": 2,
    "ghpython": {
        "isAdvancedMode": true,
        "iconDisplay": 0,
        "inputParameters": [
            {"name": "n_steps", "description": "Number of steps", "typeHintID": "int", "scriptParamAccess": 0},
            {"name": "rise", "description": "Height gained per step (m)", "typeHintID": "float", "optional": true, "scriptParamAccess": 0},
            {"name": "tread", "description": "Depth of each step (m)", "typeHintID": "float", "optional": true, "scriptParamAccess": 0},
            {"name": "width", "description": "Width of the staircase (m)", "typeHintID": "float", "optional": true, "scriptParamAccess": 0}
        ],
        "outputParameters": [
            {"name": "steps", "description": "The staircase, as Rhino Box geometry"}
        ]
    }
}
