            {"name": "brick_length", "description": "Single brick length (m)", "typeHintID": "float", "optional": true, "scriptParamAccess": 0},
            {"name": "joint", "description": "Mortar joint thickness (m)", "typeHintID": "float", "optional": true, "scriptParamAccess": 0}
        ],
        "outputParameters": [
            {"name": "bricks", "description": "The wall, as Rhino Box geometry"}
        ]
    }
