{
    "name": "Running Bond Wall",
    "nickname": "RBWall",
    "category": "COMPAS Studio",
    "subcategory": "Masonry",
    "description": "Build a running-bond brick wall from length and height. Pure COMPAS core, tested outside Rhino.",
